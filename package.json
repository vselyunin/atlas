{
  "name": "atlas",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.13 <23"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "lint": "eslint . --max-warnings=0",
    "format": "node scripts/format.mjs",
    "format:check": "node scripts/format.mjs --check",
    "typecheck": "pnpm --filter @atlas/contracts build && pnpm -r typecheck && tsc --noEmit",
    "test": "pnpm -r test && pnpm test:integration",
    "build": "pnpm -r build",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "check:commits": "node scripts/check-commits.mjs",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "pnpm --filter @atlas/contracts build && playwright test"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.0.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "eslint": "^10.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.0"
  }
}
