ATLAS_API_PORT=4310
ATLAS_DB_PATH=.atlas/atlas.sqlite
ATLAS_BOARD_ORIGIN=http://localhost:5173
ATLAS_WORKER_TOKEN=replace-with-a-local-secret
# Sign-in with GitHub: github (default) or off. Any other value stops the API.
# ATLAS_AUTH=github
# The GitHub App's secrets; a secret, never commit or print it. Relative paths start in this
# package's folder, so use an absolute path when you start the API by itself.
# ATLAS_GITHUB_APP_FILE=/absolute/path/to/.atlas/github-app.json
# GitHub addresses; for tests that use a stand-in. Leave unset.
# ATLAS_GITHUB_API_URL=https://api.github.com
# ATLAS_GITHUB_WEB_URL=https://github.com
