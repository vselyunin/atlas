{
  "name": "@atlas/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "typecheck": "node ../../scripts/run-package.mjs typecheck tsc --noEmit",
    "test": "node ../../scripts/run-package.mjs test vitest run",
    "build": "node ../../scripts/run-package.mjs build tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js"
  },
  "dependencies": {
    "@atlas/contracts": "workspace:*",
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.0.0",
    "@fastify/websocket": "^11.0.0",
    "better-sqlite3": "^12.0.0",
    "drizzle-orm": "^0.45.0",
    "fastify": "^5.0.0",
    "ws": "^8.18.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/ws": "^8.18.0",
    "drizzle-kit": "^0.31.0"
  }
}
