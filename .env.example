# Optional overrides for pnpm dev. Defaults work without copying this file.
ATLAS_API_PORT=4310
ATLAS_BOARD_ORIGIN=http://localhost:5173
ATLAS_DB_PATH=.atlas/atlas.sqlite
ATLAS_WORKER_ID=atlas:local
ATLAS_WORKER_NAME="Local Atlas worker"
ATLAS_WORKSPACE_ROOT=.atlas/projects
ATLAS_WORKER_STATE_DIR=.atlas/worker
# Set a shared secret when launching API and Worker separately.
# The combined launcher otherwise creates a local token in .atlas/worker-token.
# ATLAS_WORKER_TOKEN=
# ATLAS_API_WS_URL=ws://127.0.0.1:4310/api/v1/workers/connect
