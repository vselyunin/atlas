# Optional overrides for pnpm dev. Defaults work without copying this file.
ATLAS_API_PORT=4310
ATLAS_BOARD_ORIGIN=http://localhost:5173
ATLAS_DB_PATH=.atlas/atlas.sqlite
ATLAS_WORKER_ID=atlas:local
ATLAS_WORKER_NAME="Local Atlas worker"
ATLAS_WORKSPACE_ROOT=.atlas/projects
ATLAS_WORKER_STATE_DIR=.atlas/worker
# Set a shared secret when launching API and Worker separately.
# The combined launcher otherwise creates a local token in .atlas/worker-token.
# ATLAS_WORKER_TOKEN=
# ATLAS_API_WS_URL=ws://127.0.0.1:4310/api/v1/workers/connect
# Sign-in with GitHub; see docs/development/local-setup.md.
# github (default) or off. off removes sign-in and setup, and the Board shows a notice.
# ATLAS_AUTH=github
# The GitHub App's secrets. A secret: never commit or print this file. Default shown.
# ATLAS_GITHUB_APP_FILE=.atlas/github-app.json
# GitHub addresses; for tests that use a stand-in. Leave unset.
# ATLAS_GITHUB_API_URL=https://api.github.com
# ATLAS_GITHUB_WEB_URL=https://github.com
# Worker: the Git host for cloning GitHub repositories (pnpm dev passes it to the container).
# https, or http only for a loopback address.
# ATLAS_GIT_HOST_URL=https://github.com
# Agent sandbox settings of the containerized Worker; see docs/development/local-setup.md.
# Sandbox mode: required (default) or off. Leave unset unless you know you need off.
# ATLAS_AGENT_SANDBOX=
# Comma-separated extra hosts agents may reach, for example registry.npmjs.org,*.example.com.
# ATLAS_AGENT_ALLOWED_DOMAINS=
# Name and email for agent commits; pnpm dev fills missing ones from the host's git config.
# ATLAS_AGENT_GIT_NAME=
# ATLAS_AGENT_GIT_EMAIL=
